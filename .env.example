# Copie este arquivo para .env e preencha as URLs. Nunca commite o .env.
# Deixar uma variável vazia liga o modo demonstração daquela API (dados de exemplo no próprio front).

# URL da API Java no Render (ex.: https://acolhe-api.onrender.com)
VITE_API_URL= https://acolhe-mais-java.onrender.com

# URL da API Flask de IA (ex.: https://acolhe-ia.onrender.com)
VITE_FLASK_URL= https://acolhe-mais-ia.onrender.com
